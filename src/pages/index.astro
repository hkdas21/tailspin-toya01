---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import GameFilters from '../components/GameFilters.astro';
import type { Category, Publisher } from '../types/game';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
/** Alphabetical, unique categories kept available regardless of active browser filters. */
const categories = [...new Map(games.flatMap((game) =>
  game.category ? [[game.category.id, game.category] as const] : [],
)).values()].sort((a: Category, b: Category) => a.name.localeCompare(b.name));
/** Alphabetical, unique publishers kept available regardless of active browser filters. */
const publishers = [...new Map(games.flatMap((game) =>
  game.publisher ? [[game.publisher.id, game.publisher] as const] : [],
)).values()].sort((a: Publisher, b: Publisher) => a.name.localeCompare(b.name));
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <GameFilters {categories} {publishers} />
          <p id="filter-results" role="status" aria-live="polite" aria-atomic="true" class="mb-4 text-slate-300" data-testid="filter-results" hidden></p>
          <div id="no-matching-games" data-testid="no-matching-games" hidden>
            <EmptyState text="No games match your filters. Try another selection or clear filters." />
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('#game-filters');
  const publisher = document.querySelector<HTMLSelectElement>('#publisher-filter');
  const status = document.querySelector<HTMLParagraphElement>('#filter-results');
  const emptyState = document.querySelector<HTMLDivElement>('#no-matching-games');

  if (form && publisher && status && emptyState) {
    const checkboxes = [...form.querySelectorAll<HTMLInputElement>('input[name="category"]')];
    const cards = [...document.querySelectorAll<HTMLAnchorElement>('[data-testid="game-card"]')];

    /**
     * Applies category OR and publisher AND constraints to prerendered cards.
     *
     * @remarks
     * Updates the live result count and no-match message without moving focus.
     * Hidden cards leave both the layout and the keyboard tab order.
     */
    const updateResults = (): void => {
      const selectedCategories = new Set(checkboxes.filter((input) => input.checked).map((input) => input.value));
      let count = 0;
      for (const card of cards) {
        const matches = (selectedCategories.size === 0 || selectedCategories.has(card.dataset.categoryId ?? ''))
          && (publisher.value === '' || card.dataset.publisherId === publisher.value);
        card.hidden = !matches;
        if (matches) count++;
      }
      status.textContent = `${count} of ${cards.length} games shown`;
      emptyState.hidden = count !== 0;
    };

    form.addEventListener('change', updateResults);
    form.addEventListener('submit', (event) => event.preventDefault());
    form.addEventListener('reset', (event) => {
      event.preventDefault();
      for (const checkbox of checkboxes) checkbox.checked = false;
      publisher.value = '';
      updateResults();
    });
    updateResults();
    status.hidden = false;
    form.hidden = false;
  }
</script>
